# Backend Environment Configuration
PORT=5000
# Docker generic mongo instance. If running locally without docker use: mongodb://127.0.0.1:27017/stagepass
MONGO_URI=mongodb://mongo:27017/stagepass  

# Replace these in production with strong 64 character strings
# Generate securely via: openssl rand -base64 64
JWT_SECRET=super_secret_for_development_purposes_only
JWT_REFRESH_SECRET=super_refresh_secret_for_development_purposes_only

# Optional if you strictly want to lock CORS
FRONTEND_URL=http://localhost:3000

# Cloudinary Configuration for Image Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key  
CLOUDINARY_API_SECRET=your_api_secret
